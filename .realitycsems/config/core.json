{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Reality CSEMS Configuration",
  "description": "Core configuration for .realitycsems - A git-like structure for reality simulation layers",
  "version": "1.0.0",
  "created": "2025-12-14",
  
  "system": {
    "name": ".realitycsems",
    "type": "reality-layer-system",
    "purpose": "Actualize everything as another layer with structured multi-language support",
    "status": "production",
    "maxopt": true,
    "alwaysOn": true
  },
  
  "layers": {
    "enabled": true,
    "strategy": "git-like-branching",
    "baseLayer": "reality-base",
    "activeLayer": "reality-main",
    "supportedLayers": [
      "reality-base",
      "reality-main",
      "reality-dev",
      "reality-production",
      "reality-maxopt"
    ]
  },
  
  "releases": {
    "enabled": true,
    "format": "semantic-version",
    "strategy": "layer-based",
    "currentRelease": "v1.0.0",
    "releaseDirectory": ".realitycsems/releases"
  },
  
  "packages": {
    "enabled": true,
    "multiLanguage": true,
    "supportedLanguages": [
      "javascript",
      "python",
      "c",
      "cpp",
      "rust",
      "go",
      "java",
      "typescript"
    ],
    "packageDirectory": ".realitycsems/packages",
    "injection": {
      "enabled": true,
      "maxopt": true,
      "autoInject": true
    }
  },
  
  "refs": {
    "headsDir": ".realitycsems/refs/heads",
    "tagsDir": ".realitycsems/refs/tags",
    "remotesDir": ".realitycsems/refs/remotes"
  },
  
  "objects": {
    "storageDir": ".realitycsems/objects",
    "compression": true,
    "hashAlgorithm": "sha256"
  },
  
  "optimization": {
    "maxopt": true,
    "alwaysMaximized": true,
    "optimization100Percent": true,
    "strategies": [
      "code-optimization",
      "performance-tuning",
      "memory-efficiency",
      "execution-speed",
      "resource-management"
    ]
  },
  
  "integration": {
    "git": true,
    "npm": true,
    "docker": true,
    "realityRepos": true,
    "ungSituation": true,
    "ungField": true
  },
  
  "metadata": {
    "author": "xaoex",
    "purpose": "Reality simulation layer system with git-like structure",
    "motto": "Everything 100% maxopt always",
    "bound": "Eternal optimization"
  }
}
